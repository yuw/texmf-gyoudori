\NeedsTeXFormat{pLaTeX2e}[2020/02/02]
\ProvidesPackage{gyoudori}
   [2026/09/25 v20260925.0 style file ``gyoudori.sty''^^J
    by Yuwsuke Kieda]

% 環境フック（\AddToHook）を使うので，LaTeX 2020-10-01以降が必要
\@ifl@t@r\fmtversion{2020/10/01}{}{%
  \PackageError{gyoudori}{LaTeX 2020-10-01 or later is required}{}}

\RequirePackage{kvoptions}
\SetupKeyvalOptions{family=gyoudori,prefix=gyoudori@}
% displaymath=true|false: ディスプレイ数式環境を自動的に行ドリする（既定はfalse）
\DeclareBoolOption[false]{displaymath}
\ProcessKeyvalOptions*

%% 行ドリの基準：\normalsizeの「阿」の高さ・深さと行送り
\newdimen\@gyoudori@ht
\newdimen\@gyoudori@dp
\newdimen\@gyoudori@bs
\def\@gyoudori@metrics{%
  \begingroup
    \normalsize
    \setbox\z@\hbox{\char\jis"3024}% 阿
    \global\@gyoudori@ht\ht\z@
    \global\@gyoudori@dp\dp\z@
    \global\@gyoudori@bs\normalbaselineskip
  \endgroup}

% #1行ドリの領域の高さ：(#1-1)行送り + 阿の高さ + 阿の深さ
\def\@gyoudori@areaheight#1{%
  \dimexpr\@gyoudori@bs*(#1-1)+\@gyoudori@ht+\@gyoudori@dp\relax}

%% 領域の中での位置
\def\@gyoudori@pos@t#1{#1\vss}
\def\@gyoudori@pos@c#1{\vss#1\vss}
\def\@gyoudori@pos@b#1{\vss#1\vskip\z@}% \vskip\z@で深さを0にし，下端に揃える

\def\@gyoudori@checkpos#1{%
  \@ifundefined{@gyoudori@pos@#1}{%
    \PackageError{gyoudori}{Undefined position `#1'}{%
      The position is t, c or b.}}{}}

%% 行ドリの本体：#3を#2行ドリして，位置#1（t/c/b）に置く．
% 領域全体を1つのボックスにし，高さを1行目の字面の高さ（阿の高さ）に，深さを残り
% 全部にして\baselineskipで置く．次の行は領域の最終行から\baselineskipで送る
% （https://abenori.blogspot.com/2017/12/gyodori.html による）．
\newbox\@gyoudori@area
\def\@gyoudori@place#1#2#3{%
  \@gyoudori@metrics
  \setbox\@gyoudori@area\vbox to\@gyoudori@areaheight{#2}{%
    \csname @gyoudori@pos@#1\endcsname{#3}}%
  \dp\@gyoudori@area
    \dimexpr\ht\@gyoudori@area+\dp\@gyoudori@area-\@gyoudori@ht\relax
  \ht\@gyoudori@area\@gyoudori@ht
  \par
  \moveright\@totalleftmargin\box\@gyoudori@area
  \par
  \prevdepth\@gyoudori@dp}

%% 行ドリした環境の直後
% 空行がなければ後続の段落を字下げせず，\parskipも入れない（リスト内の\parsepで
% 行送りがずれないように）．空行があれば通常の段落とする．
% 環境を抜けた後に，LaTeXの\@doendpeと同じしくみで処理する．
\def\@gyoudori@doendpe{%
  \edef\@gyoudori@restoreparskip{\parskip\the\parskip\relax}%
  \parskip\z@skip
  \@endpetrue
  \def\par{%
    \@restorepar\@gyoudori@restoreparskip
    \clubpenalty\@clubpenalty\@endpefalse\everypar{}\par}%
  \everypar{{\setbox\z@\lastbox}%
    \@gyoudori@restoreparskip\everypar{}\@endpefalse}}

%% ユーザー命令
\newbox\@gyoudori@box
\newenvironment{gyoudori}[2][c]{%
  \@gyoudori@checkpos{#1}%
  \def\@gyoudori@args{{#1}{#2}}%
  \setbox\@gyoudori@box\vbox\bgroup}{%
  \egroup
  \expandafter\@gyoudori@place\@gyoudori@args{\box\@gyoudori@box}}
\AddToHook{env/gyoudori/after}{\@gyoudori@doendpe}

\newcommand\gyoudoriarea[3][c]{%
  \@gyoudori@checkpos{#1}%
  \@gyoudori@place{#1}{#2}{#3}}

%% ディスプレイ数式の自動行ドリ（displaymath=true）
% 数式を環境の外側で開いたボックスに組み，それが収まる最少の行数（2行以上）で
% 行ドリして中央に置く．
\newbox\@gyoudori@mathbox
\newcount\@gyoudori@lines

\def\@gyoudori@math@begin{%
  \par
  \setbox\@gyoudori@mathbox\vbox\bgroup
    \hsize\linewidth \parshape\z@
    \abovedisplayskip\z@ \belowdisplayskip\z@
    \abovedisplayshortskip\z@ \belowdisplayshortskip\z@
    \noindent}

\def\@gyoudori@math@end{%
    \par
    \unskip\unpenalty\unskip\unpenalty % \belowdisplayskipと\postdisplaypenaltyを除く
  \egroup
  \@gyoudori@metrics
  \@gyoudori@lines\tw@
  \@whiledim\@gyoudori@areaheight\@gyoudori@lines
      <\dimexpr\ht\@gyoudori@mathbox+\dp\@gyoudori@mathbox\relax\do
    {\advance\@gyoudori@lines\@ne}%
  \@gyoudori@place{c}{\@gyoudori@lines}{\box\@gyoudori@mathbox}%
  \@gyoudori@doendpe}

% 環境のグループの外側（before/after）にフックする．align*は内部で\endalignを
% 呼ぶが，フックは\begin/\endでだけ働くので二重にはならない．
\def\@gyoudori@math@hook#1{%
  \AddToHook{env/#1/before}{\@gyoudori@math@begin}%
  \AddToHook{env/#1/after}{\@gyoudori@math@end}}

\ifgyoudori@displaymath
  \@gyoudori@math@hook{eqnarray}
  \@gyoudori@math@hook{eqnarray*}
  \@gyoudori@math@hook{align}
  \@gyoudori@math@hook{align*}
  \@gyoudori@math@hook{gather}
  \@gyoudori@math@hook{gather*}
\fi

\endinput
