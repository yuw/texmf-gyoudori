\RequirePackage{kvoptions}
\SetupKeyvalOptions{family=gyoudori,prefix=gyoudori@}
% displaymath=true|false: ディスプレイ数式環境を自動的に行ドリする（既定はfalse）
\DeclareBoolOption[false]{displaymath}
\ProcessKeyvalOptions*

\def\@tmp@skip@t{t}%
\def\@tmp@skip@c{c}%
\def\@tmp@skip@b{b}%

\def\@gyoudori@opt@chck#1{%
  \def\@tmp@skip@opt{#1}%
  \@tfor\@tempa:={#1}\do{%
    \ifx\@tempa\@tmp@skip@t\relax
    \else
      \ifx\@tempa\@tmp@skip@c\relax
      \else
        \ifx\@tempa\@tmp@skip@b\relax
        \else
          \PackageError{gyoudoriarea}{%
            Undefined option of command the gyoudoriarea! Option is only t, c or b}{%
            Option of command the gyoudoriarea is only t, c or b.}
        \fi
      \fi
    \fi}}

\newcount\@gyoudori@cnt

\def\@gyoudori@heading#1{
  \leavevmode\par\vspace*{-\dimexpr \Cht + \Cdp \relax}
  \noindent
  \vbox to \dimexpr \@gyoudori@cnt\Cvs + \Cht \relax{%
    \ifx\@tmp@skip@opt\@tmp@skip@c\vss\fi
    \ifx\@tmp@skip@opt\@tmp@skip@b\vss\fi
    #1
    \ifx\@tmp@skip@opt\@tmp@skip@t\vss\fi
    \ifx\@tmp@skip@opt\@tmp@skip@c\vss\vskip-\Cdp\fi
    \ifx\@tmp@skip@opt\@tmp@skip@b\vskip-\Cdp\fi
  }%
}

\def\@gyoudori@count@lines#1{
  \@gyoudori@cnt#1\relax
  \@gyoudori@cnt\numexpr\@gyoudori@cnt - 1\relax
}

\newbox\@gyoudori@box

\def\gyoudori{\@testopt{\@gyoudori}{c}}
\def\@gyoudori[#1]#2{%
  \@gyoudori@opt@chck{#1}
  \@gyoudori@count@lines{#2}
  \setbox\@gyoudori@box\vbox\bgroup
}
\def\endgyoudori{%
  \egroup
  \@gyoudori@heading{\box\@gyoudori@box}
}

\def\gyoudoriarea{\@testopt{\@gyoudoriarea}{c}}
\def\@gyoudoriarea[#1]#2#3{%
  \@gyoudori@opt@chck{#1}
  \@gyoudori@count@lines{#2}
  \@gyoudori@heading{#3}
}

% ディスプレイ数式の自動行ドリ
%   対象：eqnarray(*)，align(*)，gather(*)
%   数式全体を収める最少の行数（ただし2行以上）で行ドリし，その中で天地中央に置く．
%   n行ドリの領域の高さは(n-1)\Cvs + \Cht + \Cdp．

\newbox\@gyoudori@mbox

\def\@gyoudori@math@begin{%
  \par
  \setbox\@gyoudori@mbox\vbox\bgroup
    \hsize\linewidth \parshape\z@
    \abovedisplayskip\z@ \belowdisplayskip\z@
    \abovedisplayshortskip\z@ \belowdisplayshortskip\z@
    \let\@gyoudori@math@end\@gyoudori@math@end@
    \noindent}

% align*の終了処理は内部で\endalignを呼ぶので，終了処理が二重に働かないよう，
% \@gyoudori@math@endはボックスの中でだけ実体を持つ
\let\@gyoudori@math@end\relax
\def\@gyoudori@math@end@{%
    \par
    % 数式後の\belowdisplayskipと\postdisplaypenaltyを除く
    \unskip\unpenalty\unskip\unpenalty
  \egroup
  \@gyoudori@math@place
  % 後続の段落は，空行がなければ字下げしない
  \global\@endpetrue
  \global\@ignoretrue}

\def\@gyoudori@math@place{%
  % \@tempcnta = n - 1 = max(1, ceil((数式の高さ - \Cht - \Cdp)/\Cvs))
  \@tempdima\dimexpr\ht\@gyoudori@mbox+\dp\@gyoudori@mbox-\Cht-\Cdp\relax
  \@tempcnta\@tempdima
  \@tempcntb\Cvs
  \divide\@tempcnta\@tempcntb
  \ifdim\@tempcnta\Cvs<\@tempdima \advance\@tempcnta\@ne\fi
  \ifnum\@tempcnta<\@ne \@tempcnta\@ne\fi
  % 領域の1行目を\baselineskipで行送りの位置に置き，その字面の上端に戻る
  \hbox{\vrule\@height\Cht\@depth\z@\@width\z@}%
  \nobreak\nointerlineskip
  \vskip-\Cht
  \moveright\@totalleftmargin
  \vbox to\dimexpr\@tempcnta\Cvs+\Cht+\Cdp\relax{%
    \vss\box\@gyoudori@mbox\vss}%
  % 次の行を領域の最終行から\baselineskipで送る
  \prevdepth\Cdp}

\def\@gyoudori@math@patch#1{%
  \@ifundefined{#1}{}{%
    \expandafter\let\csname @gyoudori@orig@#1\expandafter\endcsname
      \csname #1\endcsname
    \expandafter\let\csname @gyoudori@orig@end#1\expandafter\endcsname
      \csname end#1\endcsname
    \expandafter\edef\csname #1\endcsname{%
      \noexpand\@gyoudori@math@begin
      \expandafter\noexpand\csname @gyoudori@orig@#1\endcsname}%
    \expandafter\edef\csname end#1\endcsname{%
      \expandafter\noexpand\csname @gyoudori@orig@end#1\endcsname
      \noexpand\@gyoudori@math@end}}}

\ifgyoudori@displaymath
  \AtBeginDocument{%
    \@for\@tempa:=eqnarray,eqnarray*,align,align*,gather,gather*\do{%
      \expandafter\@gyoudori@math@patch\expandafter{\@tempa}}}
\fi

\endinput
